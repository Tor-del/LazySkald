<Window x:Class="ScreenReader.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource app.title}" Width="1058" Height="1005" MinWidth="920" MinHeight="690" Background="{StaticResource FluentBackdrop}" Foreground="{StaticResource FluentText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Assets/storyteller.ico">
 <Window.Resources>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,16,6"/><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Foreground" Value="{StaticResource FluentSecondary}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
       <ContentPresenter x:Name="TabHeader" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <Border x:Name="SelectionIndicator" Width="3" Height="18" CornerRadius="2" Background="{StaticResource FluentAccent}" HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E5E8ED"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E2E7EE"/><Setter Property="Foreground" Value="{StaticResource FluentText}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource FluentAccent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="#FAFBFC"/><Setter Property="BorderBrush" Value="#E1E4E8"/>
   <Setter Property="TabStripPlacement" Value="Left"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabControl">
     <Grid KeyboardNavigation.TabNavigation="Local">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
      <Border Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
       <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" BorderBrush="#E9EBEF" BorderThickness="0,0,0,1" Padding="28,24,28,20">
         <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="22" FontWeight="SemiBold"/>
        </Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0" KeyboardNavigation.TabIndex="2"/>
       </DockPanel>
      </Border>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource FluentBackdrop}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="26,22,26,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Image Source="Assets/storyteller.png" Width="54" Height="54" HorizontalAlignment="Left"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="LazySkald" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource FluentText}"/>
    <TextBlock Text="{DynamicResource app.subtitle}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,0,24,18">
   <TabItem Header="{DynamicResource tab.recognition}" Tag="&#xE8A7;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <TextBlock Text="{DynamicResource ocr.provider}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="OcrProviderBox" DisplayMemberPath="Name" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.ocrLanguage}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" SelectionChanged="LanguageChanged" Margin="0,0,0,0"/>
      <TextBlock x:Name="OcrHint" Foreground="#7B5617" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
      <TextBlock Text="{DynamicResource label.captureMode}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CaptureModeBox" DisplayMemberPath="Name" Margin="0,0,0,20"/>
      <CheckBox x:Name="OcrReplaceLineBreaksBox" Content="{DynamicResource ocr.replaceLineBreaks}" Margin="0,0,0,12"/>
      <CheckBox x:Name="OcrPreserveParagraphsBox" Content="{DynamicResource ocr.preserveParagraphs}" IsEnabled="{Binding IsChecked, ElementName=OcrReplaceLineBreaksBox}" Margin="20,0,0,8"/>
      <TextBlock Text="{DynamicResource ocr.lineBreaksHint}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.translation}" Tag="&#xE8C1;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <CheckBox x:Name="TranslateEnabledBox" Content="{DynamicResource translation.enabled}" Checked="TranslationLanguageChanged" Unchecked="TranslationLanguageChanged" Margin="0,0,0,24"/>
     <TextBlock Text="{DynamicResource translation.provider}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TranslationProviderBox" DisplayMemberPath="Name" SelectionChanged="TranslationProviderChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.url}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TranslationUrlBox" TextChanged="TranslationConnectionChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource label.apiKey}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="TranslationKeyBox" PasswordChanged="TranslationConnectionChanged" Margin="0,0,0,20"/>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="RefreshModelsButton" Content="{DynamicResource button.refresh}" Click="RefreshTranslationModels" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.model}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
     <ComboBox x:Name="TranslationModelBox" IsEditable="True" Margin="0,0,0,0"/>
     <TextBlock x:Name="TranslationModelsHint" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <TextBlock Text="{DynamicResource translation.target}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TranslationTargetBox" IsEditable="True" DisplayMemberPath="Name" TextSearch.TextPath="Tag" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.prompt}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TranslationPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"/>
     <TextBlock Text="{DynamicResource translation.promptHint}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="TranslationStressMarksBox" Content="{DynamicResource translation.stressMarks}"/>
     <TextBlock Text="{DynamicResource translation.stressMarksHint}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="TranslationTemperatureEnabledBox" Content="{DynamicResource translation.temperature}"/>
     <TextBox x:Name="TranslationTemperatureBox" Margin="0,8,0,20"/>
     <TextBlock Text="{DynamicResource translation.timeoutLabel}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TranslationTimeoutBox" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.privacy}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.genderization}" Tag="&#xE716;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <CheckBox x:Name="GenderEnabledBox" Content="{DynamicResource gender.enabled}" Checked="GenderEnabledChanged" Unchecked="GenderEnabledChanged" Margin="0,0,0,24"/>
     <TextBlock Text="{DynamicResource gender.provider}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GenderProviderBox" DisplayMemberPath="Name" SelectionChanged="GenderProviderChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.url}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GenderUrlBox" TextChanged="GenderConnectionChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource label.apiKey}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="GenderKeyBox" PasswordChanged="GenderConnectionChanged" Margin="0,0,0,20"/>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="RefreshGenderModelsButton" Content="{DynamicResource button.refresh}" Click="RefreshGenderModels" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.model}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
     <ComboBox x:Name="GenderModelBox" IsEditable="True" Margin="0,0,0,0"/>
     <TextBlock x:Name="GenderModelsHint" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <TextBlock Text="{DynamicResource gender.prompt}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GenderPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"/>
     <TextBlock Text="{DynamicResource gender.promptHint}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="GenderTemperatureEnabledBox" Content="{DynamicResource translation.temperature}"/>
     <TextBox x:Name="GenderTemperatureBox" Margin="0,8,0,20"/>
     <TextBlock Text="{DynamicResource translation.timeoutLabel}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GenderTimeoutBox" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource gender.privacy}" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.speech}" Tag="&#xE767;">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="28,24">
      <StackPanel x:Name="RoleVoicesPanel" Visibility="Collapsed" Margin="0,0,0,16">
       <TextBlock Text="{DynamicResource speech.roles}" Style="{StaticResource FieldLabel}"/>
       <ListBox x:Name="SpeechRolesBox" DisplayMemberPath="Name" SelectionChanged="SpeechRoleChanged" MinHeight="38" MaxHeight="120"/>
       <WrapPanel Margin="0,8,0,8">
        <Button x:Name="AddFemaleRoleButton" Content="{DynamicResource speech.addFemale}" Click="AddFemaleRole"/>
        <Button x:Name="AddMaleRoleButton" Content="{DynamicResource speech.addMale}" Click="AddMaleRole"/>
        <Button x:Name="RemoveRoleButton" Content="{DynamicResource speech.removeRole}" Click="RemoveSpeechRole"/>
       </WrapPanel>
       <TextBlock Text="{DynamicResource speech.rolesHint}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" FontSize="12"/>
      </StackPanel>
      <TextBlock x:Name="SpeechRoleHeading" Text="{DynamicResource speech.defaultRole}" FontWeight="SemiBold" Margin="0,6,0,20"/>
      <TextBlock Text="{DynamicResource label.provider}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectionChanged="ProviderChanged" Margin="0,0,0,20"/>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="RefreshVoicesButton" Content="{DynamicResource button.refresh}" Click="RefreshVoices" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.voice}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
      <ComboBox x:Name="VoiceBox" DisplayMemberPath="FriendlyName" Margin="0"/>
      <StackPanel x:Name="ServerPanel" Visibility="Collapsed" Margin="0,12,0,0">
       <TextBlock Text="{DynamicResource label.endpoint}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EndpointBox" ToolTip="http://127.0.0.1:5050/v1/audio/speech" Margin="0,0,0,20"/>
       <TextBlock Text="{DynamicResource label.model}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelBox" Margin="0,0,0,20"/>
       <TextBlock Text="{DynamicResource label.apiKey}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,20"/>
       <TextBlock Text="{DynamicResource label.format}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AudioFormatBox" Margin="0,0,0,20"/>
      </StackPanel>
      <TextBlock x:Name="VoiceHint" Foreground="{StaticResource FluentSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"/>
      <DockPanel><TextBlock Text="{DynamicResource label.speed}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="RateLabel" HorizontalAlignment="Right"/></DockPanel>
      <Slider x:Name="RateSlider" Minimum="-50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="RateChanged" Margin="0,5,0,16"/>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{DynamicResource button.refresh}" Click="RefreshAudioDevices" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.device}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
      <ComboBox x:Name="AudioDeviceBox" DisplayMemberPath="Name" Margin="0,0,0,0"/>
      <TextBlock Text="{DynamicResource hint.device}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FluentSecondary}" Margin="0,5,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.preview}" Tag="&#xE768;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <TextBox x:Name="PreviewText" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto"/>
     <TextBlock Text="{DynamicResource hint.preview}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FluentSecondary}" Margin="0,8,0,16"/>
     <TextBlock Text="{DynamicResource translation.result}" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="TranslationPreview" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>
     <TextBlock x:Name="GenderPreview" TextWrapping="Wrap" Margin="0,0,0,16">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
       <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <WrapPanel><Button Content="{DynamicResource button.listen}" Click="PreviewSpeech" Style="{StaticResource AccentButton}"/><Button Content="{DynamicResource button.stop}" Click="StopSpeech"/></WrapPanel>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.cache}" Tag="&#xE8B7;">
    <Grid Margin="28,24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <CheckBox x:Name="CacheEnabledBox" Content="{DynamicResource cache.enabled}" Margin="0,0,0,10"/>
     <TextBlock Grid.Row="1" Text="{DynamicResource cache.hint}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" Margin="0,6,0,20"/>
     <Button Grid.Row="2" Content="{DynamicResource cache.openFolder}" Click="OpenCacheFolder" HorizontalAlignment="Left" Margin="0,6,0,20"/>
     <Grid Grid.Row="3" IsEnabled="{Binding IsChecked, ElementName=CacheEnabledBox}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,10">
       <Button Content="{DynamicResource cache.replay}" Click="ReplayCache"/>
       <Button Content="{DynamicResource cache.delete}" Click="DeleteCache"/>
       <Button Content="{DynamicResource cache.clear}" Click="ClearCache"/>
      </WrapPanel>
      <ListBox x:Name="CacheList" Grid.Row="1" SelectionChanged="CacheSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBox x:Name="CacheDetails" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="{DynamicResource tab.queue}" Tag="&#xE8FD;">
    <Grid Margin="28,24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,12"><Button Content="{DynamicResource queue.cancelCurrent}" Click="CancelQueueCurrent"/><Button Content="{DynamicResource queue.cancelAll}" Click="StopSpeech"/></WrapPanel>
     <ListBox x:Name="QueueList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </TabItem>
   <TabItem Header="{DynamicResource tab.controls}" Tag="&#xE765;">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="28,24">
      <TextBlock Text="{DynamicResource label.hotkey}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="ToggleKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyQueue}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="CaptureKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyRepeatQueue}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="RepeatCaptureKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyCancelCurrent}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="CancelCurrentKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyCancelAll}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="CancelAllKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource hint.hotkey}" FontSize="12" Foreground="{StaticResource FluentSecondary}" TextWrapping="Wrap" Margin="0,6,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyMode}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HotkeyModeBox" DisplayMemberPath="Name" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource hint.game}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" FontSize="12" Margin="0,6,0,20"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="OllamaTab" Header="Ollama" Tag="&#xE950;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24" Loaded="OllamaLoaded">
     <TextBlock Text="{DynamicResource ollama.intro}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" Margin="0,0,0,16"/>
     <TextBlock x:Name="OllamaHardwareText" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock x:Name="OllamaRecommendationText" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" Margin="0,6,0,20"/>
     <TextBlock Text="{DynamicResource label.model}" Style="{StaticResource FieldLabel}"/>
     <ComboBox x:Name="OllamaModelBox" DisplayMemberPath="Name" SelectionChanged="OllamaModelChanged" Margin="0,0,0,20"/>
     <TextBlock x:Name="OllamaModelHint" TextWrapping="Wrap" Foreground="#7B5617" Margin="0,6,0,20"/>
     <TextBlock x:Name="OllamaStateText" Text="{DynamicResource ollama.unchecked}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <WrapPanel>
      <Button x:Name="OllamaCheckButton" Content="{DynamicResource ollama.check}" Click="CheckOllama"/>
      <Button x:Name="OllamaSetupButton" Content="{DynamicResource ollama.setup}" Click="SetupOllama"/>
      <Button x:Name="OllamaCancelButton" Content="{DynamicResource button.stop}" Click="CancelOllama" IsEnabled="False"/>
     </WrapPanel>
     <ProgressBar x:Name="OllamaProgressBar" Height="12" Minimum="0" Maximum="100" Margin="0,14,0,8"/>
     <TextBlock x:Name="OllamaProgressText" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <Button x:Name="OllamaUseButton" Content="{DynamicResource ollama.use}" Click="UseOllamaModel" IsEnabled="False" HorizontalAlignment="Left"/>
     <TextBlock Text="{DynamicResource ollama.note}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" FontSize="12" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.application}" Tag="&#xE713;">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="28,24">
      <TextBlock Text="{DynamicResource label.uiLanguage}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="UiLanguageBox" DisplayMemberPath="Name" SelectionChanged="UiLanguageChanged" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.behavior}" FontWeight="SemiBold" Margin="0,6,0,20"/>
      <CheckBox x:Name="CloseToTrayBox" Content="{DynamicResource check.closeToTray}" Margin="0,0,0,10"/>
      <CheckBox x:Name="StartInTrayBox" Content="{DynamicResource check.startInTray}"/>
      <TextBlock Text="{DynamicResource hint.startInTray}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FluentSecondary}" Margin="0,6,0,24"/>
      <TextBlock Text="{DynamicResource label.about}" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="VersionText" Foreground="#172C46"/>
      <TextBlock Text="{DynamicResource hint.about}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" Margin="0,6,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.help}" Tag="&#xE897;">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="28,24">
      <TextBlock Text="{DynamicResource help.setupTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock Text="{DynamicResource help.setup}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.readTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock x:Name="HelpCaptureText" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource help.read}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.moreTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock Text="{DynamicResource help.more}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.ollama}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.troubleshootTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock Text="{DynamicResource help.troubleshoot}" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#BFFFFFFF" BorderBrush="#DFE3EA" BorderThickness="0,1,0,0" Padding="26,16">
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="{DynamicResource ready}" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" Margin="0,0,0,12"/>
    <WrapPanel><Button Content="{DynamicResource button.save}" Click="SaveSettings" Style="{StaticResource AccentButton}"/><Button Content="{DynamicResource button.hide}" Click="HideWindow"/><Button Content="{DynamicResource button.log}" Click="OpenLog"/></WrapPanel>
    <TextBlock x:Name="PrivacyHint" TextWrapping="Wrap" Foreground="{StaticResource FluentSecondary}" FontSize="12" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
