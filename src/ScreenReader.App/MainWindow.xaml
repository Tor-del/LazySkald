      <TextBox x:Name="CancelCurrentKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyCancelAll}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="CancelAllKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource overlay.interactionHotkey}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="OverlayControlsKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource overlay.interactionHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource hint.hotkey}" FontSize="12" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" Margin="0,6,0,20"/>
      <CheckBox x:Name="ExclusiveHotkeysBox" Content="{DynamicResource controls.exclusive}" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource controls.exclusiveHint}" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="12"/>
      <TextBlock x:Name="ExclusiveHotkeyModeHint" Text="{DynamicResource controls.exclusiveMode}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" FontSize="12" Margin="0,0,0,20">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ExclusiveHotkeysBox}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
