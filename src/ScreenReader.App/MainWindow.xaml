        <Style TargetType="StackPanel">
         <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ExclusiveHotkeysBox}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Text="{DynamicResource label.hotkeyMode}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HotkeyModeBox" DisplayMemberPath="Name" Margin="0,0,0,20"/>
