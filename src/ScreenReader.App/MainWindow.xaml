<Window x:Class="ScreenReader.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource app.title}" Width="1058" Height="1055" MinWidth="920" MinHeight="690" Background="{DynamicResource FluentBackdrop}" Foreground="{DynamicResource FluentText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Assets/storyteller.ico">
 <Window.Resources>
  <Style x:Key="OllamaMenuItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="MenuSurface" Background="Transparent" CornerRadius="4" Padding="10,8" Margin="0,1">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="MenuBox" Width="17" Height="17" BorderThickness="1" BorderBrush="{DynamicResource FluentCheckStroke}" Background="{DynamicResource FluentSurface}" CornerRadius="3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Left">
       <Path x:Name="MenuCheck" Data="M 1 6 L 5 10 L 13 1" Stroke="{DynamicResource FluentAccentText}" StrokeThickness="1.6" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsCheckable" Value="True"><Setter TargetName="MenuBox" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/><Setter TargetName="MenuBox" Property="Background" Value="{DynamicResource FluentAccent}"/><Setter TargetName="MenuBox" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource FluentHover}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OllamaMenu" TargetType="ContextMenu">
   <Setter Property="Foreground" Value="{DynamicResource FluentText}"/><Setter Property="ItemContainerStyle" Value="{StaticResource OllamaMenuItem}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{DynamicResource FluentPopup}" BorderBrush="{DynamicResource FluentPopupStroke}" BorderThickness="1" CornerRadius="7" Padding="5" MinWidth="210">
     <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,16,6"/><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Foreground" Value="{DynamicResource FluentSecondary}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
       <ContentPresenter x:Name="TabHeader" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <Border x:Name="SelectionIndicator" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource FluentAccent}" HorizontalAlignment="Left" Margin="-16,0,0,0" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FluentTabHover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FluentTabSelected}"/><Setter Property="Foreground" Value="{DynamicResource FluentText}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CorrectionTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
   <Setter Property="Margin" Value="20,-4,16,10"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="HeaderTemplate">
    <Setter.Value><DataTemplate>
     <TextBlock Text="{Binding}" Width="128" Height="38" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" FontWeight="SemiBold"/>
    </DataTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
   <Setter Property="Background" Value="{DynamicResource FluentPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource FluentPanelStroke}"/>
   <Setter Property="TabStripPlacement" Value="Left"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabControl">
     <Grid KeyboardNavigation.TabNavigation="Local">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
      <Border Grid.Column="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
       <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FluentDivider}" BorderThickness="0,0,0,1" Padding="28,24,28,20">
         <TextBlock Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="22" FontWeight="SemiBold"/>
        </Border>
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0" KeyboardNavigation.TabIndex="2"/>
       </DockPanel>
      </Border>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource FluentBackdrop}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="26,22,26,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Image Source="Assets/storyteller.png" Width="54" Height="54" HorizontalAlignment="Left"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="LazySkald" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource FluentText}"/>
    <TextBlock Text="{DynamicResource app.subtitle}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,0,24,18">
   <TabItem Header="{DynamicResource tab.recognition}" Tag="&#xE8A7;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <TextBlock Text="{DynamicResource ocr.provider}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="OcrProviderBox" DisplayMemberPath="Name" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.ocrLanguage}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" SelectionChanged="LanguageChanged" Margin="0,0,0,0"/>
      <TextBlock x:Name="OcrHint" Foreground="{DynamicResource FluentWarning}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
      <TextBlock Text="{DynamicResource label.captureMode}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CaptureModeBox" DisplayMemberPath="Name" Margin="0,0,0,20"/>
      <CheckBox x:Name="OcrReplaceLineBreaksBox" Content="{DynamicResource ocr.replaceLineBreaks}" Margin="0,0,0,12"/>
      <CheckBox x:Name="OcrPreserveParagraphsBox" Content="{DynamicResource ocr.preserveParagraphs}" IsEnabled="{Binding IsChecked, ElementName=OcrReplaceLineBreaksBox}" Margin="20,0,0,8"/>
      <TextBlock Text="{DynamicResource ocr.lineBreaksHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.textCorrection}" Tag="&#xE70F;" Style="{StaticResource CorrectionTab}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <CheckBox x:Name="OcrCorrectionsEnabledBox" Content="{DynamicResource ocr.correctionsEnabled}" Margin="0,0,0,12"/>
     <TextBlock Text="{DynamicResource ocr.correctionsHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"/>
     <StackPanel IsEnabled="{Binding IsChecked, ElementName=OcrCorrectionsEnabledBox}">
      <TextBlock Text="{DynamicResource ocr.entrySource}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="OcrSourceBox" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource translation.entryReplacement}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="OcrReplacementBox" Margin="0,0,0,12"/>
      <WrapPanel Margin="0,0,0,12">
       <CheckBox x:Name="OcrIgnoreCaseBox" Content="{DynamicResource translation.entryIgnoreCase}" IsChecked="False" Margin="0,0,0,8"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,8">
       <Button x:Name="OcrCorrectionAddButton" Content="{DynamicResource translation.entryAdd}" Click="AddOcrCorrection" Style="{StaticResource AccentButton}"/>
       <Button x:Name="OcrCorrectionCancelButton" Content="{DynamicResource translation.entryCancel}" Click="CancelOcrCorrection" Visibility="Collapsed"/>
      </WrapPanel>
      <TextBlock x:Name="OcrCorrectionError" Foreground="{DynamicResource FluentError}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     </StackPanel>
     <TextBlock Text="{DynamicResource ocr.correctionRules}" Style="{StaticResource FieldLabel}"/>
     <TextBlock Text="{DynamicResource ocr.entriesHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
     <ListBox x:Name="OcrCorrectionsList" MinHeight="130" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Margin="4,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
         <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FontWeight="SemiBold"/>
         <TextBlock FontSize="11" Foreground="{DynamicResource FluentSecondary}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource translation.entryCaseSensitive}"/><Style.Triggers><DataTrigger Binding="{Binding IgnoreCase}" Value="True"><Setter Property="Text" Value="{DynamicResource translation.entryIgnoreCase}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Replacement}"/><Style.Triggers><DataTrigger Binding="{Binding Replacement}" Value=""><Setter Property="Text" Value="{DynamicResource ocr.entryDeleteText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource translation.entryEdit}" AutomationProperties.Name="{DynamicResource translation.entryEdit}" Tag="{Binding}" Click="EditOcrCorrection" Padding="8,4" MinWidth="30" MinHeight="30"/>
         <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource translation.entryDelete}" AutomationProperties.Name="{DynamicResource translation.entryDelete}" Tag="{Binding}" Click="DeleteOcrCorrection" Padding="8,4" MinWidth="30" MinHeight="30" Margin="4,0,0,0"/>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.translation}" Tag="&#xE8C1;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <CheckBox x:Name="TranslateEnabledBox" Content="{DynamicResource translation.enabled}" Checked="TranslationLanguageChanged" Unchecked="TranslationLanguageChanged" Margin="0,0,0,24"/>
     <TextBlock Text="{DynamicResource translation.provider}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TranslationProviderBox" DisplayMemberPath="Name" SelectionChanged="TranslationProviderChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.url}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TranslationUrlBox" TextChanged="TranslationConnectionChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource label.apiKey}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="TranslationKeyBox" PasswordChanged="TranslationConnectionChanged" Margin="0,0,0,20"/>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="RefreshModelsButton" Content="{DynamicResource button.refresh}" Click="RefreshTranslationModels" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.model}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
     <ComboBox x:Name="TranslationModelBox" IsEditable="True" Margin="0,0,0,0"/>
     <TextBlock x:Name="TranslationModelsHint" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <TextBlock Text="{DynamicResource translation.target}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TranslationTargetBox" IsEditable="True" DisplayMemberPath="Name" TextSearch.TextPath="Tag" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.prompt}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TranslationPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"/>
     <TextBlock Text="{DynamicResource translation.promptHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="TranslationStressMarksBox" Content="{DynamicResource translation.stressMarks}"/>
     <TextBlock Text="{DynamicResource translation.stressMarksHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="TranslationStripMarkdownBox" Content="{DynamicResource translation.stripMarkdown}"/>
     <TextBlock Text="{DynamicResource translation.stripMarkdownHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="TranslationTemperatureEnabledBox" Content="{DynamicResource translation.temperature}"/>
     <TextBox x:Name="TranslationTemperatureBox" Margin="0,8,0,20"/>
     <TextBlock Text="{DynamicResource translation.timeoutLabel}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TranslationTimeoutBox" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.privacy}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.translationCorrection}" Tag="&#xE70F;" Style="{StaticResource CorrectionTab}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24" IsEnabled="{Binding IsChecked, ElementName=TranslateEnabledBox}">
     <CheckBox x:Name="TranslationCorrectionsEnabledBox" Content="{DynamicResource translation.correctionsEnabled}" Margin="0,0,0,12"/>
     <TextBlock Text="{DynamicResource translation.correctionsHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"/>
     <StackPanel IsEnabled="{Binding IsChecked, ElementName=TranslationCorrectionsEnabledBox}">
      <TextBlock Text="{DynamicResource translation.entrySource}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="TranslationSourceBox" Margin="0,0,0,12"/>
      <TextBlock Text="{DynamicResource translation.entryReplacement}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="TranslationReplacementBox" Margin="0,0,0,12"/>
      <WrapPanel Margin="0,0,0,12">
       <CheckBox x:Name="TranslationPreserveBox" Content="{DynamicResource translation.entryPreserve}" Checked="TranslationPreserveChanged" Unchecked="TranslationPreserveChanged" Margin="0,0,20,8"/>
       <CheckBox x:Name="TranslationIgnoreCaseBox" Content="{DynamicResource translation.entryIgnoreCase}" IsChecked="True" Margin="0,0,0,8"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,8">
       <Button x:Name="TranslationCorrectionAddButton" Content="{DynamicResource translation.entryAdd}" Click="AddTranslationCorrection" Style="{StaticResource AccentButton}"/>
       <Button x:Name="TranslationCorrectionCancelButton" Content="{DynamicResource translation.entryCancel}" Click="CancelTranslationCorrection" Visibility="Collapsed"/>
      </WrapPanel>
      <TextBlock x:Name="TranslationCorrectionError" Foreground="{DynamicResource FluentError}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     </StackPanel>
     <TextBlock Text="{DynamicResource translation.correctionRules}" Style="{StaticResource FieldLabel}"/>
     <TextBlock Text="{DynamicResource translation.entriesHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
     <ListBox x:Name="TranslationCorrectionsList" MinHeight="130" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Margin="4,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
         <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FontWeight="SemiBold"/>
         <TextBlock FontSize="11" Foreground="{DynamicResource FluentSecondary}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource translation.entryCaseSensitive}"/><Style.Triggers><DataTrigger Binding="{Binding IgnoreCase}" Value="True"><Setter Property="Text" Value="{DynamicResource translation.entryIgnoreCase}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Replacement}"/><Style.Triggers><DataTrigger Binding="{Binding Preserve}" Value="True"><Setter Property="Text" Value="{DynamicResource translation.entryPreserve}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource translation.entryEdit}" AutomationProperties.Name="{DynamicResource translation.entryEdit}" Tag="{Binding}" Click="EditTranslationCorrection" Padding="8,4" MinWidth="30" MinHeight="30"/>
         <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="{DynamicResource translation.entryDelete}" AutomationProperties.Name="{DynamicResource translation.entryDelete}" Tag="{Binding}" Click="DeleteTranslationCorrection" Padding="8,4" MinWidth="30" MinHeight="30" Margin="4,0,0,0"/>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.genderization}" Tag="&#xE716;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
     <CheckBox x:Name="GenderEnabledBox" Content="{DynamicResource gender.enabled}" Checked="GenderEnabledChanged" Unchecked="GenderEnabledChanged" Margin="0,0,0,24"/>
     <TextBlock Text="{DynamicResource gender.provider}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GenderProviderBox" DisplayMemberPath="Name" SelectionChanged="GenderProviderChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource translation.url}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GenderUrlBox" TextChanged="GenderConnectionChanged" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource label.apiKey}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="GenderKeyBox" PasswordChanged="GenderConnectionChanged" Margin="0,0,0,20"/>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="RefreshGenderModelsButton" Content="{DynamicResource button.refresh}" Click="RefreshGenderModels" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.model}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
     <ComboBox x:Name="GenderModelBox" IsEditable="True" Margin="0,0,0,0"/>
     <TextBlock x:Name="GenderModelsHint" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <TextBlock Text="{DynamicResource gender.prompt}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GenderPromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0"/>
     <TextBlock Text="{DynamicResource gender.promptHint}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,20"/>
     <CheckBox x:Name="GenderTemperatureEnabledBox" Content="{DynamicResource translation.temperature}"/>
     <TextBox x:Name="GenderTemperatureBox" Margin="0,8,0,20"/>
     <TextBlock Text="{DynamicResource translation.timeoutLabel}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GenderTimeoutBox" Margin="0,0,0,20"/>
     <TextBlock Text="{DynamicResource gender.privacy}" Foreground="{DynamicResource FluentSecondary}" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.speech}" Tag="&#xE767;">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="28,24">
      <CheckBox x:Name="SpeechEnabledBox" Content="{DynamicResource speech.enabled}" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource speech.enabledHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" FontSize="12" Margin="0,0,0,20"/>
      <StackPanel x:Name="RoleVoicesPanel" Visibility="Collapsed" Margin="0,0,0,16">
       <TextBlock Text="{DynamicResource speech.roles}" Style="{StaticResource FieldLabel}"/>
       <ListBox x:Name="SpeechRolesBox" DisplayMemberPath="Name" SelectionChanged="SpeechRoleChanged" MinHeight="38" MaxHeight="120"/>
       <WrapPanel Margin="0,8,0,8">
        <Button x:Name="AddFemaleRoleButton" Content="{DynamicResource speech.addFemale}" Click="AddFemaleRole"/>
        <Button x:Name="AddMaleRoleButton" Content="{DynamicResource speech.addMale}" Click="AddMaleRole"/>
        <Button x:Name="AddFallbackRoleButton" Content="{DynamicResource speech.addFallback}" Click="AddFallbackRole"/>
        <Button x:Name="RemoveRoleButton" Content="{DynamicResource speech.removeRole}" Click="RemoveSpeechRole"/>
       </WrapPanel>
       <TextBlock Text="{DynamicResource speech.rolesHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" FontSize="12"/>
      </StackPanel>
      <TextBlock x:Name="SpeechRoleHeading" Text="{DynamicResource speech.defaultRole}" FontWeight="SemiBold" Margin="0,6,0,20"/>
      <TextBlock Text="{DynamicResource label.provider}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectionChanged="ProviderChanged" Margin="0,0,0,20"/>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" x:Name="RefreshVoicesButton" Content="{DynamicResource button.refresh}" Click="RefreshVoices" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.voice}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
      <ComboBox x:Name="VoiceBox" DisplayMemberPath="FriendlyName" Margin="0"/>
      <StackPanel x:Name="ServerPanel" Visibility="Collapsed" Margin="0,12,0,0">
       <TextBlock Text="{DynamicResource label.endpoint}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EndpointBox" ToolTip="http://127.0.0.1:5050/v1/audio/speech" Margin="0,0,0,20"/>
       <TextBlock Text="{DynamicResource label.model}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModelBox" Margin="0,0,0,20"/>
       <TextBlock Text="{DynamicResource label.apiKey}" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,20"/>
       <TextBlock Text="{DynamicResource label.format}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AudioFormatBox" Margin="0,0,0,20"/>
      </StackPanel>
      <TextBlock x:Name="VoiceHint" Foreground="{DynamicResource FluentSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"/>
      <DockPanel><TextBlock Text="{DynamicResource speech.volume}" Style="{StaticResource FieldLabel}"/><TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}"/></DockPanel>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5,0,16"/>
      <TextBlock Text="{DynamicResource speech.fallbackHint}" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="12"/>
      <DockPanel><TextBlock Text="{DynamicResource label.speed}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="RateLabel" HorizontalAlignment="Right"/></DockPanel>
      <Slider x:Name="RateSlider" Minimum="-50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="RateChanged" Margin="0,5,0,16"/>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{DynamicResource button.refresh}" Click="RefreshAudioDevices" Padding="10,3" MinHeight="28" Margin="12,0,0,0"/><TextBlock Text="{DynamicResource label.device}" VerticalAlignment="Center" Margin="0" Style="{StaticResource FieldLabel}"/></DockPanel>
      <ComboBox x:Name="AudioDeviceBox" DisplayMemberPath="Name" Margin="0,0,0,0"/>
