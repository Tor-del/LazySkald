      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="OllamaTab" Header="Ollama" Tag="&#xE950;">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24" Loaded="OllamaLoaded">
     <Border Background="{DynamicResource FluentSurface}" BorderBrush="{DynamicResource FluentStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="{DynamicResource ollama.computer}" Style="{StaticResource FieldLabel}"/>
       <TextBlock x:Name="OllamaCpuText" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock x:Name="OllamaHardwareText" TextWrapping="Wrap"/>
       <TextBlock x:Name="OllamaRecommendationText" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock x:Name="OllamaDriverWarning" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource FluentWarning}" Margin="0,0,0,12" Visibility="Collapsed"/>
     <Expander x:Name="OllamaDriversExpander" Header="{DynamicResource ollama.drivers}" Foreground="{DynamicResource FluentText}" HorizontalContentAlignment="Stretch" Margin="0,0,0,16">
      <Expander.Template>
       <ControlTemplate TargetType="Expander">
        <Border Background="{DynamicResource FluentSurface}" BorderBrush="{DynamicResource FluentStroke}" BorderThickness="1" CornerRadius="8">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{DynamicResource ollama.drivers}">
           <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
             <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="14,13">
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
               <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
               <Path x:Name="Chevron" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource FluentSecondary}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              </Grid>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource FluentSurfaceHover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </ToggleButton.Template>
          </ToggleButton>
          <Border x:Name="DriverContent" Grid.Row="1" Visibility="Collapsed" Padding="16,0,16,16">
           <StackPanel>
            <Border Background="{DynamicResource FluentStroke}" Height="1" Margin="0,0,0,14"/>
            <ContentPresenter HorizontalAlignment="Stretch"/>
           </StackPanel>
          </Border>
         </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DriverContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate>
      </Expander.Template>
      <StackPanel HorizontalAlignment="Stretch">
       <TextBlock x:Name="OllamaDriverText" TextWrapping="Wrap" Margin="0,0,0,14"/>
       <WrapPanel Margin="0,0,0,6">
        <Button x:Name="OllamaDriverCheckButton" Content="{DynamicResource ollama.driverCheck}" Click="CheckOllamaDrivers" Margin="0,0,8,8"/>
        <Button x:Name="OllamaNvidiaButton" Content="NVIDIA" Tag="https://www.nvidia.com/Download/index.aspx" Click="OpenOllamaDriverPage" Visibility="Collapsed" Margin="0,0,8,8"/>
        <Button x:Name="OllamaAmdButton" Content="AMD" Tag="https://www.amd.com/en/support" Click="OpenOllamaDriverPage" Visibility="Collapsed" Margin="0,0,8,8"/>
        <Button x:Name="OllamaIntelButton" Content="Intel" Tag="https://www.intel.com/content/www/us/en/download-center/home.html" Click="OpenOllamaDriverPage" Visibility="Collapsed" Margin="0,0,8,8"/>
       </WrapPanel>
       <Border Background="{DynamicResource FluentStroke}" Height="1" Margin="0,0,0,14"/>
       <TextBlock x:Name="OllamaRequirementsText" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,0,12"/>
       <WrapPanel Margin="0,0,0,4">
        <Button x:Name="OllamaRequirementsButton" Content="{DynamicResource ollama.refreshRequirements}" Click="RefreshOllamaRequirements" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource ollama.gpuSupport}" Click="OpenOllamaDriverPage" Margin="0,0,0,8"/>
       </WrapPanel>
       <TextBlock Text="{DynamicResource ollama.driverHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" FontSize="12"/>
      </StackPanel>
     </Expander>
     <Border Background="{DynamicResource FluentSurface}" BorderBrush="{DynamicResource FluentStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Ollama" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="OllamaStateText" Text="{DynamicResource ollama.unchecked}" TextWrapping="Wrap"/>
       </StackPanel>
       <WrapPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="OllamaStartButton" Content="{DynamicResource ollama.startServer}" Click="StartOllama" Visibility="Collapsed"/>
        <Button x:Name="OllamaCheckButton" Content="{DynamicResource ollama.check}" Click="CheckOllama" Margin="0"/>
       </WrapPanel>
      </Grid>
     </Border>
     <Border x:Name="OllamaOperationPanel" BorderBrush="{DynamicResource FluentStroke}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
      <StackPanel>
       <DockPanel Margin="0,0,0,8">
        <Button x:Name="OllamaCancelButton" DockPanel.Dock="Right" Content="{DynamicResource button.stop}" Click="CancelOllama" IsEnabled="False" Margin="8,0,0,0"/>
        <TextBlock x:Name="OllamaProgressText" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </DockPanel>
       <ProgressBar x:Name="OllamaProgressBar" Height="6" Minimum="0" Maximum="100"/>
      </StackPanel>
     </Border>
     <TextBlock Text="{DynamicResource ollama.catalog}" Style="{StaticResource FieldLabel}" Margin="0,4,0,8"/>
     <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,8,0">
       <TextBox x:Name="OllamaSearchBox" TextChanged="OllamaSearchChanged" AutomationProperties.Name="{DynamicResource ollama.search}" Padding="12,8"/>
       <TextBlock Text="{DynamicResource ollama.search}" Margin="13,0" VerticalAlignment="Center" Foreground="{DynamicResource FluentSecondary}" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=OllamaSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Button x:Name="OllamaFilterButton" Grid.Column="1" Click="OpenOllamaModelMenu" Padding="10,8">
       <Button.ToolTip><ToolTip><TextBlock Text="{DynamicResource ollama.filterHint}" TextWrapping="Wrap" MaxWidth="360"/></ToolTip></Button.ToolTip>
       <StackPanel Orientation="Horizontal"><TextBlock x:Name="OllamaFilterLabel" Text="{DynamicResource ollama.filters}"/><TextBlock Text=" ▾"/></StackPanel>
       <Button.ContextMenu>
        <ContextMenu Style="{StaticResource OllamaMenu}">
         <MenuItem Header="{DynamicResource ollama.filterDownloaded}" Tag="Downloaded" IsCheckable="True" StaysOpenOnClick="True" Click="OllamaFilterChanged"/>
         <MenuItem Header="{DynamicResource ollama.filterNotDownloaded}" Tag="NotDownloaded" IsCheckable="True" StaysOpenOnClick="True" Click="OllamaFilterChanged"/>
         <MenuItem Header="{DynamicResource ollama.filterRecommended}" Tag="Recommended" IsCheckable="True" StaysOpenOnClick="True" Click="OllamaFilterChanged"/>
         <MenuItem Header="{DynamicResource ollama.filterSupported}" Tag="Supported" IsCheckable="True" StaysOpenOnClick="True" Click="OllamaFilterChanged"/>
         <MenuItem Header="{DynamicResource ollama.filterUnsupported}" Tag="Unsupported" IsCheckable="True" StaysOpenOnClick="True" Click="OllamaFilterChanged"/>
         <MenuItem Header="{DynamicResource ollama.resetFilters}" Click="ResetOllamaFilters"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
      <Button x:Name="OllamaSortButton" Grid.Column="2" Click="OpenOllamaModelMenu" Padding="10,8" Margin="0">
       <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource ollama.sort}"/><TextBlock Text=" ▾"/></StackPanel>
       <Button.ContextMenu>
        <ContextMenu Style="{StaticResource OllamaMenu}">
         <MenuItem Header="{DynamicResource ollama.sortDefault}" Tag="Default" IsCheckable="True" IsChecked="True" Click="OllamaSortChanged"/>
         <MenuItem Header="{DynamicResource ollama.sortName}" Tag="Name" IsCheckable="True" Click="OllamaSortChanged"/>
         <MenuItem Header="{DynamicResource ollama.sortSizeAscending}" Tag="SizeAscending" IsCheckable="True" Click="OllamaSortChanged"/>
         <MenuItem Header="{DynamicResource ollama.sortSizeDescending}" Tag="SizeDescending" IsCheckable="True" Click="OllamaSortChanged"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
     </Grid>
     <TextBlock x:Name="OllamaModelsCount" Foreground="{DynamicResource FluentSecondary}" FontSize="12" Margin="0,0,0,10"/>
     <TextBlock Text="{DynamicResource ollama.modelsHint}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,0,16"/>
     <TextBlock x:Name="OllamaModelsEmpty" Text="{DynamicResource ollama.noResults}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,8,0,16" Visibility="Collapsed"/>
     <ItemsControl x:Name="OllamaModelsList" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{DynamicResource ollama.catalog}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="{DynamicResource FluentSurface}" BorderBrush="{DynamicResource FluentStroke}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
         <StackPanel>
          <Grid Margin="0,0,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,12,0"/>
           <Border Grid.Column="1" Background="{DynamicResource FluentTabSelected}" CornerRadius="4" Padding="8,3" VerticalAlignment="Top">
            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" MaxWidth="230"/>
           </Border>
          </Grid>
          <WrapPanel Margin="0,0,0,8">
           <TextBlock Text="{Binding Size}" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,12,0"/>
           <TextBlock Text="{DynamicResource ollama.recommendedBadge}" Foreground="{DynamicResource FluentAccent}" Visibility="{Binding RecommendedVisibility}"/>
          </WrapPanel>
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <WrapPanel Visibility="{Binding RequirementsVisibility}" Margin="0,0,0,8">
           <TextBlock x:Name="RamRequirementText" Text="{Binding RamText}" FontSize="12" Margin="0,0,14,4">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FluentSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding MissingRam}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FluentError}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
           <TextBlock x:Name="VramRequirementText" Text="{Binding VramText}" FontSize="12" Margin="0,0,14,4" ToolTip="{DynamicResource ollama.vramHint}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource FluentSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding MissingVram}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FluentError}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding AvailableRamText}" Foreground="{DynamicResource FluentWarning}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="{Binding AvailableRamVisibility}" ToolTip="{DynamicResource ollama.lowMemory}"/>
          </WrapPanel>
          <WrapPanel>
           <Button x:Name="RowDownloadButton" Content="{Binding PullLabel}" Click="SetupOllama" IsEnabled="{Binding CanDownload}" Visibility="{Binding PullVisibility}" Margin="0,0,8,4"/>
           <Button x:Name="RowUseButton" Content="{DynamicResource ollama.use}" Click="UseOllamaModel" IsEnabled="{Binding CanUse}" Visibility="{Binding ManageVisibility}" Margin="0,0,8,4"/>
           <Button x:Name="RowDeleteButton" Content="{DynamicResource ollama.delete}" Click="DeleteOllamaModel" IsEnabled="{Binding CanDelete}" Visibility="{Binding ManageVisibility}" Margin="0,0,0,4"/>
          </WrapPanel>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.application}" Tag="&#xE713;">
