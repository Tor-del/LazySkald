      <TextBlock Text="{DynamicResource label.hotkeyQueue}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="CaptureKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource label.hotkeyRepeatQueue}" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="RepeatCaptureKeyBox" IsReadOnly="True" PreviewKeyDown="CaptureKeyDown" PreviewMouseDown="CaptureMouseDown" ContextMenu="{x:Null}" ToolTip="{DynamicResource hint.hotkeyField}" Margin="0,0,0,20"/>
