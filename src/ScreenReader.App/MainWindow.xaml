      <TextBlock Text="{DynamicResource hint.about}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,6,0,0"/>
      <TextBlock Text="{DynamicResource about.author}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,12,0,6"/>
      <TextBlock><Hyperlink NavigateUri="https://github.com/Tor-del/LazySkald" RequestNavigate="OpenProjectGitHub" Foreground="{DynamicResource FluentAccent}">GitHub · Tor-del/LazySkald</Hyperlink></TextBlock>
      <TextBlock Text="{DynamicResource about.ai}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,6,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="{DynamicResource tab.help}" Tag="&#xE897;">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="28,24">
      <TextBlock Text="{DynamicResource help.setupTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock Text="{DynamicResource help.setup}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.readTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock x:Name="HelpCaptureText" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource help.read}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.moreTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock Text="{DynamicResource help.more}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.ollama}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <TextBlock Text="{DynamicResource help.troubleshootTitle}" Style="{StaticResource FieldLabel}"/>
      <TextBlock Text="{DynamicResource help.troubleshoot}" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="{DynamicResource FluentFooter}" BorderBrush="{DynamicResource FluentFooterStroke}" BorderThickness="0,1,0,0" Padding="26,16">
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="{DynamicResource ready}" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" Margin="0,0,0,12"/>
    <WrapPanel>
     <Button Content="{DynamicResource button.save}" Click="SaveSettings" Style="{StaticResource AccentButton}"/>
     <Button x:Name="CaptureButton" Click="CaptureAndQueue" AutomationProperties.Name="{DynamicResource button.captureQueue}">
      <StackPanel Orientation="Horizontal">
       <Viewbox Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
        <Path Data="M 0,5 L 0,0 5,0 M 11,0 L 16,0 16,5 M 16,11 L 16,16 11,16 M 5,16 L 0,16 0,11 M 4,5 L 12,5 M 4,8 L 12,8 M 4,11 L 9,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
       </Viewbox>
       <TextBlock Text="{DynamicResource button.captureQueue}" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button x:Name="SetupWizardButton" Content="{DynamicResource wizard.title}" Click="OpenSetupWizard"/>
    </WrapPanel>
    <TextBlock x:Name="PrivacyHint" TextWrapping="Wrap" Foreground="{DynamicResource FluentSecondary}" FontSize="12" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
