<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LazySkald</AssemblyName>
    <RootNamespace>ScreenReader.App</RootNamespace>
    <Product>LazySkald</Product>
    <Title>LazySkald</Title>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/storyteller.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScreenReader.Checks" />
    <EmbeddedResource Include="Localization/strings*.json" WithCulture="false" />
    <EmbeddedResource Include="OllamaGpuRequirements.json" />
    <EmbeddedResource Include="Assets/storyteller.ico" />
    <PackageReference Include="Markdig" Version="1.5.1" />
    <Resource Include="Assets/storyteller.png" />
    <Resource Include="Assets/storyteller.ico" />
    <ProjectReference Include="../ScreenReader.Edge/ScreenReader.Edge.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>
</Project>
