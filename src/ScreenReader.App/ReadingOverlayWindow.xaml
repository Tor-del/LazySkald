<Window x:Class="ScreenReader.App.ReadingOverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LazySkald Overlay" WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height"
 Width="360" MinWidth="260" MaxWidth="800" MaxHeight="600" ShowInTaskbar="False" ShowActivated="False"
 Topmost="True" AllowsTransparency="True" Background="Transparent" Foreground="#F5F6FA"
 FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="OverlayKeyDown">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#354153"/><Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="4,0,0,0"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#526581"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#526581"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Frame" Background="#ED1D2531" BorderBrush="#64748B" BorderThickness="1" CornerRadius="10" Padding="12">
  <StackPanel>
   <Grid MouseLeftButtonDown="DragHeader">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StageText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
    <Button x:Name="PauseButton" Grid.Column="1" Content="Ⅱ" Click="TogglePause" Visibility="Collapsed"/>
    <Button x:Name="CloseButton" Grid.Column="2" Content="✕" Click="CloseJob" AutomationProperties.Name="{DynamicResource overlay.close}"/>
   </Grid>
   <StackPanel x:Name="PlaybackPanel" Visibility="Collapsed" Margin="0,10,0,0">
    <ProgressBar x:Name="PlaybackBar" Height="5" Minimum="0" Maximum="1" Foreground="#71B5FF" Background="#354153"/>
    <TextBlock x:Name="TimeText" Foreground="#C1CCDB" FontSize="12" Margin="0,5,0,0"/>
   </StackPanel>
   <ScrollViewer x:Name="TranslationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,12,0,0">
    <TextBlock x:Name="TranslationText" TextWrapping="Wrap" FontSize="16"/>
   </ScrollViewer>
   <TextBlock x:Name="InteractionHint" Text="{DynamicResource overlay.interacting}" Foreground="#9DCCFF" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
   <StackPanel x:Name="ConfigurationPanel" Visibility="Collapsed" Margin="0,12,0,0">
    <TextBlock Text="{DynamicResource overlay.dragHint}" TextWrapping="Wrap" Foreground="#C1CCDB" FontSize="12" Margin="0,0,0,12"/>
    <Grid>
     <WrapPanel Margin="0,0,22,0">
      <Button Content="{DynamicResource overlay.usePosition}" Click="SaveLayout" Margin="0,0,6,6"/>
      <Button Content="{DynamicResource overlay.cancel}" Click="CancelLayout" Margin="0,0,6,6"/>
     </WrapPanel>
     <Thumb Width="18" Height="24" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="ResizeWidget">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#354153" CornerRadius="3"><TextBlock Text="↔" Foreground="#C1CCDB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template>
     </Thumb>
    </Grid>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
